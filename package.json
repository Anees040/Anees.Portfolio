{
  "name": "anees-portfolio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3200",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "test:ask": "playwright test --config playwright.ask.config.ts",
    "ask-anees:index": "node --experimental-strip-types scripts/ask-anees-index.ts",
